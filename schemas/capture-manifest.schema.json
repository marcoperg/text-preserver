{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-preserver.invalid/schemas/capture-manifest.schema.json",
  "title": "text-preserver capture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "collection_id",
    "status",
    "started_at",
    "selected_sources",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "capture_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9]{6,16}$"
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "status": {
      "enum": ["complete", "complete_with_warnings", "partial", "interrupted", "failed"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "operator_note": { "type": "string" },
    "selected_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceResult" }
    }
  },
  "$defs": {
    "sourceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "required", "status", "started_at"],
      "properties": {
        "source_id": { "type": "string" },
        "required": { "type": "boolean" },
        "status": {
          "enum": ["complete", "complete_with_warnings", "partial", "interrupted", "failed", "not_run"]
        },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "exit_code": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" }
          ]
        },
        "downloaded_files": { "type": "integer", "minimum": 0 },
        "downloaded_bytes": { "type": "integer", "minimum": 0 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
