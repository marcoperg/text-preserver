{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-preserver.invalid/schemas/capture-manifest.schema.json",
  "title": "text-preserver capture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "collection_id",
    "status",
    "started_at",
    "selected_sources",
    "sources",
    "payload_roles"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "capture_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9]{6,16}$"
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "status": {
      "enum": ["running", "complete", "complete_with_warnings", "partial", "interrupted", "failed"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "error": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "selected_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceResult" }
    },
    "payload_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/payloadRole" }
    }
  },
  "$defs": {
    "payloadRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
        },
        "role": {
          "enum": ["preservation_original", "capture_derivative", "metadata"]
        }
      }
    },
    "sourceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "required",
        "status",
        "started_at",
        "ended_at",
        "exit_code",
        "downloaded_files",
        "downloaded_bytes",
        "payloads",
        "warnings",
        "error"
      ],
      "properties": {
        "source_id": { "type": "string" },
        "required": { "type": "boolean" },
        "status": {
          "enum": ["running", "complete", "complete_with_warnings", "partial", "interrupted", "failed", "not_run"]
        },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "exit_code": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" }
          ]
        },
        "downloaded_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Compatibility alias for payloads.mirror.files; zero for WARC-only captures."
        },
        "downloaded_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Compatibility alias for payloads.mirror.bytes; zero for WARC-only captures."
        },
        "payloads": {
          "$ref": "#/$defs/payloads"
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "payloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirror", "warc"],
      "properties": {
        "mirror": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "bytes"],
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0,
              "description": "Retained regular files in the access mirror."
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Bytes in retained regular access-mirror files."
            }
          }
        },
        "warc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "bytes",
            "cdx_files",
            "indexed_records",
            "has_response_or_resource"
          ],
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0,
              "description": "Retained regular WARC container files, excluding CDX and temporary files."
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Bytes in retained WARC container files, excluding CDX and temporary files."
            },
            "cdx_files": {
              "type": "integer",
              "minimum": 0,
              "description": "Retained regular GNU Wget CDX files."
            },
            "indexed_records": {
              "oneOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "null" }
              ],
              "description": "Non-header GNU Wget CDX records, or null when no safely readable CDX is available."
            },
            "has_response_or_resource": {
              "type": "boolean",
              "description": "Whether CDX records or bounded WARC inspection provide evidence of a response or resource record."
            }
          }
        }
      }
    }
  }
}
