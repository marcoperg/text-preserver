{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-preserver.invalid/schemas/config.schema.json",
  "title": "text-preserver configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["project"],
  "anyOf": [
    {
      "required": ["collections"],
      "properties": { "collections": { "minItems": 1 } }
    },
    {
      "required": ["recipes"],
      "properties": { "recipes": { "minItems": 1 } }
    }
  ],
  "properties": {
    "project": { "$ref": "#/$defs/project" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "recipes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "collections": {
      "type": "array",
      "items": { "$ref": "#/$defs/collection" }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_root", "operator", "contact", "user_agent"],
      "properties": {
        "archive_root": { "type": "string", "minLength": 1 },
        "derived_root": { "type": "string", "minLength": 1 },
        "workspace_root": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "minLength": 1 },
        "contact": { "type": "string", "minLength": 1 },
        "user_agent": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture": { "$ref": "#/$defs/captureSettings" }
      }
    },
    "captureSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "enum": ["wget"] },
        "recursive": { "type": "boolean" },
        "level": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "const": "inf" }
          ]
        },
        "page_requisites": { "type": "boolean" },
        "convert_links": { "type": "boolean" },
        "adjust_extension": { "type": "boolean" },
        "content_disposition": { "type": "boolean" },
        "mirror": { "type": "boolean" },
        "warc": { "type": "boolean" },
        "warc_cdx": { "type": "boolean" },
        "warc_max_size": { "$ref": "#/$defs/byteSize" },
        "robots": { "type": "boolean" },
        "wait": { "type": "number", "minimum": 0 },
        "random_wait": { "type": "boolean" },
        "timeout": { "type": "number", "exclusiveMinimum": 0 },
        "tries": { "type": "integer", "minimum": 1 },
        "retry_connrefused": { "type": "boolean" },
        "span_hosts": { "type": "boolean" },
        "no_parent": { "type": "boolean" },
        "quota": { "$ref": "#/$defs/byteSize" },
        "limit_rate": { "$ref": "#/$defs/byteSize" },
        "accept": { "$ref": "#/$defs/stringList" },
        "reject": { "$ref": "#/$defs/stringList" },
        "accept_regex": { "type": "string", "minLength": 1 },
        "reject_regex": { "type": "string", "minLength": 1 },
        "success_exit_codes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 },
          "uniqueItems": true
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "byteSize": {
      "type": "string",
      "pattern": "^[1-9][0-9]*[KkMmGg]?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "seeds", "allowed_hosts"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "kind": { "enum": ["web", "http-file"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "engine": { "enum": ["wget"] },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
        },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"
          }
        },
        "capture": { "$ref": "#/$defs/captureSettings" }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inventory_adapter": { "type": "string", "minLength": 1 },
        "reader_adapter": { "type": "string", "minLength": 1 },
        "normalizer": { "type": "string", "minLength": 1 },
        "ciao_rules": { "type": "string", "minLength": 1 },
        "reader_source": { "$ref": "#/$defs/safeId" },
        "expected_work_count": { "type": "integer", "minimum": 0 },
        "prefer_preserved_adapter": { "type": "boolean" },
        "required_representation_kinds": { "$ref": "#/$defs/stringList" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "title": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "description": { "type": "string" },
        "risk_note": { "type": "string" },
        "rights_note": { "type": "string" },
        "tags": { "$ref": "#/$defs/stringList" },
        "enabled": { "type": "boolean" },
        "capture": { "$ref": "#/$defs/captureSettings" },
        "analysis": { "$ref": "#/$defs/analysis" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  }
}
